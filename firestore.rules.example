rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /siteContent/current {
      allow read: if true;
      allow write: if request.auth != null
        && (
          request.auth.token.email in [
            'tristan@solarflarerobotics.org',
            'rishi@solarflarerobotics.org',
            'ryan@solarflarerobotics.org',
            'arjun@solarflarerobotics.org'
          ]
        );
    }
  }
}
